{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "node resources/pwa/generate-icons.mjs && tsc --noEmit && vite build",
        "dev": "vite",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:browser": "playwright test",
        "typecheck": "tsc --noEmit",
        "test:pwa": "playwright test --config=playwright.pwa.config.ts"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.14.0",
        "@playwright/test": "^1.64.1",
        "@tailwindcss/vite": "^4.0.0",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "concurrently": "^10.0.3",
        "fake-indexeddb": "^6.2.6",
        "jsdom": "^30.1.3",
        "laravel-vite-plugin": "^3.1",
        "lighthouse": "^13.6.0",
        "sharp": "^0.35.5",
        "tailwindcss": "^4.0.0",
        "typescript": "^7.0.2",
        "vite": "^8.0.0",
        "vite-plugin-pwa": "^2.0.0",
        "vitest": "^5.0.5",
        "workbox-core": "^7.4.1",
        "workbox-precaching": "^7.4.1",
        "workbox-routing": "^7.4.1",
        "workbox-strategies": "^7.4.1"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "@fontsource-variable/instrument-sans": "^5.3.0",
        "lucide-react": "^1.63.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1"
    }
